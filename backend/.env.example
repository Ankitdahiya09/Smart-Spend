# ─────────────────────────────────────────────────────────────
#  SmartSpend  —  Backend Environment Variables
#  Copy this file to .env and fill in YOUR values.
#  NEVER commit the real .env to GitHub.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGO_URL=mongodb://localhost:27017

# MongoDB database name (can be anything you like)
DB_NAME=smartspend

# A long random string used to sign JWT tokens
# Generate one at: https://generate-secret.vercel.app/64
JWT_SECRET=replace-with-a-long-random-secret

# ── AI (OpenAI) ───────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# The receipt scanning feature uses gpt-4o vision
OPENAI_API_KEY=sk-proj-replace-with-your-openai-key

# CORS — set to your frontend URL in production
# e.g.  CORS_ORIGINS=https://myapp.vercel.app
CORS_ORIGINS=*
